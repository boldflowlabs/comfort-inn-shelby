# ─── Database ────────────────────────────────────────────────────────
# SQLite (local/VPS) — use file path
DATABASE_URL="file:./dev.db"

# PostgreSQL (Vercel/Cloud) — uncomment and set your connection string
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# ─── Admin Dashboard ─────────────────────────────────────────────────
ADMIN_EMAIL="owner@comfortshelby.com"
ADMIN_PASSWORD="change-this-strong-password"
JWT_SECRET="generate-a-random-32-char-secret-here"

# ─── n8n Automation Webhook ──────────────────────────────────────────
# Replace with your live n8n webhook URL (production, not webhook-test)
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/elara-events"
